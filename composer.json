{
    "name": "hexcj/api-builder-laravel",
    "description": "A dynamic Laravel API endpoint builder driven by database configuration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0",
        "illuminate/database": "^10.0",
        "illuminate/http": "^10.0",
        "illuminate/routing": "^10.0",
        "illuminate/support": "^10.0",
        "doctrine/dbal": "^3.6 || ^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelApiBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelApiBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelApiBuilder\\Providers\\ApiBuilderServiceProvider"
            ],
            "aliases": {
                "ApiBuilder": "LaravelApiBuilder\\Facades\\ApiBuilder"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
